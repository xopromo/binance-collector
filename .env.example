# ─── Telegram ────────────────────────────────────────────────────────────────
# Получи на https://my.telegram.org/apps
TG_API_ID=12345678
TG_API_HASH=abcdef1234567890abcdef1234567890abcd
# Канал: @username, https://t.me/username, или числовой ID -1001234567890
TG_CHANNEL=@signal_channel

# ─── Claude API ──────────────────────────────────────────────────────────────
# https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...

# ─── Groq API (Whisper) ───────────────────────────────────────────────────────
# https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# ─── Bybit API ────────────────────────────────────────────────────────────────
# https://www.bybit.com/app/user/api-management
# Нужны права: Contract - Trade (Read + Write)
BYBIT_API_KEY=your_bybit_api_key
BYBIT_API_SECRET=your_bybit_api_secret
# Поставь true для тестнета (testnet.bybit.com)
BYBIT_TESTNET=false

# ─── Параметры торговли ───────────────────────────────────────────────────────
DEFAULT_LEVERAGE=10
DEFAULT_SIZE_USDT=100
# Минимальный порог уверенности Claude для исполнения сигнала (0.0 - 1.0)
MIN_CONFIDENCE=0.65
