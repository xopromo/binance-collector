{
  "name": "trading-dashboard",
  "version": "1.0.0",
  "description": "Multi-strategy trading dashboard with TradingView MCP and Claude AI analysis",
  "type": "module",
  "scripts": {
    "analyze": "node scripts/run_analysis.js",
    "analyze:strategy": "node scripts/run_analysis.js --strategy",
    "analyze:watch": "node scripts/run_analysis.js --watch",
    "collect": "node scripts/collect_data.js",
    "push": "node scripts/push_results.js",
    "push:all": "node scripts/push_results.js --all"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1"
  }
}
